 ;-------------------------------------------------
+; [CB-018] 当页悬停角色选定：结果写全局 QOL_DYN_PAGE_DEC
+; （-1 未定 / 0 本页无角色换帧 / >0 = 选中角色 CID，声明见 CB-019）。
+; 单角色页 50% 掷币；多角色页按好感度（CFLAG:角色ID:好感度）降序插入排序，
+; 再按秩加权随机挑一个（秩 i 权重 = N-i，好感度越高越易被挑中）。
+; 随机种子取 GETMILLISECOND/997 + LINECOUNT*31 + 角色数，零消耗游戏 RNG。
+; 选中角色若无可用悬停帧，ASSEMBLE 守卫链自然回退基础帧（本页无人动），可接受。
+;-------------------------------------------------
+@QOL_DYN_PICK_HOVER(PICK_LIST, PICK_COUNT)
+#LOCALSIZE 1
+#LOCALSSIZE 1
+#DIM REF PICK_LIST
+#DIM PICK_COUNT
+#DIM DYNAMIC L_DYN_ORDER, 50
+#DIM DYNAMIC L_DYN_AFF, 50
+#DIM DYNAMIC L_DYN_CID
+#DIM DYNAMIC L_DYN_AFFI
+#DIM DYNAMIC L_DYN_I
+#DIM DYNAMIC L_DYN_J
+#DIM DYNAMIC L_DYN_K
+#DIM DYNAMIC L_DYN_TOTAL
+#DIM DYNAMIC L_DYN_R
+#DIM DYNAMIC L_DYN_ACC
+
+IF PICK_COUNT <= 0
+	QOL_DYN_PAGE_DEC = 0
+	RETURN RESULT
+ENDIF
+IF PICK_COUNT == 1
+	QOL_DYN_PAGE_DEC = (GETMILLISECOND() % 100) < 50 ? PICK_LIST:0 # 0
+	RETURN RESULT
+ENDIF
+; 插入排序：按好感度降序把 PICK_LIST 排入 L_DYN_ORDER
+; （CFLAG 第 1 下标须先落标量变量：数组元素 PICK_LIST:i 直接写会解析成三级下标）
+L_DYN_CID = PICK_LIST:0
+L_DYN_ORDER:0 = L_DYN_CID
+L_DYN_AFF:0 = CFLAG:L_DYN_CID:好感度
+FOR L_DYN_I, 1, PICK_COUNT-1
+	L_DYN_CID = PICK_LIST:L_DYN_I
+	L_DYN_AFFI = CFLAG:L_DYN_CID:好感度
+	L_DYN_J = L_DYN_I - 1
+	WHILE L_DYN_J >= 0 && L_DYN_AFF:L_DYN_J < L_DYN_AFFI
+		L_DYN_K = L_DYN_J + 1
+		L_DYN_ORDER:L_DYN_K = L_DYN_ORDER:L_DYN_J
+		L_DYN_AFF:L_DYN_K = L_DYN_AFF:L_DYN_J
+		L_DYN_J = L_DYN_J - 1
+	WEND
+	L_DYN_K = L_DYN_J + 1
+	L_DYN_ORDER:L_DYN_K = L_DYN_CID
+	L_DYN_AFF:L_DYN_K = L_DYN_AFFI
+NEXT
+; 秩加权随机：秩 i 权重 = PICK_COUNT - i，总权重 = N*(N+1)/2
+L_DYN_TOTAL = PICK_COUNT * (PICK_COUNT + 1) / 2
+L_DYN_R = (GETMILLISECOND()/997 + LINECOUNT*31 + PICK_COUNT) % L_DYN_TOTAL
+L_DYN_ACC = 0
+QOL_DYN_PAGE_DEC = L_DYN_ORDER:0
+FOR L_DYN_I, 0, PICK_COUNT-1
+	L_DYN_ACC += PICK_COUNT - L_DYN_I
+	IF L_DYN_R < L_DYN_ACC
+		QOL_DYN_PAGE_DEC = L_DYN_ORDER:L_DYN_I
+		BREAK
+	ENDIF
+NEXT
+RETURN RESULT
+
