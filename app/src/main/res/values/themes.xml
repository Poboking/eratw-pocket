<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 无 AndroidX：直接继承系统 Material 主题（API 21+） -->
    <!--
      `tools:targetApi="23"`：`android:windowLightStatusBar` 是 API 23 才有的属性，
      minSdk 是 21 —— 21/22 上平台会**忽略**未知属性，不会崩，所以这里不是缺兼容分支，
      而是 lint 的 NewApi 误报。用 tools 声明（纯 lint 指令，不改任何运行时行为）。
    -->
    <style name="Theme.Eratw" parent="@android:style/Theme.Material.NoActionBar" tools:targetApi="23">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
      浮层开合动效（`EratwShellDialog.dress` 用）：进场淡入 + 96% 放大 + 3% 上浮，出场淡出收一档。
      只管「这一层压下来了」这一件事，不叠加弹跳/旋转。时长与缓动见 res/anim/shell_dialog_*。
    -->
    <style name="ShellDialogAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/shell_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/shell_dialog_out</item>
    </style>

    <!--
      这里**故意没有**设置页专用主题：SettingsActivity 继承 application 的 Theme.Eratw，
      是不透明的全屏窗口，因而拥有自己的方向域（manifest 的 unspecified = 跟随系统转动）。
      半透明/浮动窗口会被框架按它下面那只 Activity 的方向定屏，把设置页钉死在游戏的
      SENSOR_LANDSCAPE 锁里（2026-11-14 玩家反馈「竖着拿手机也转不成竖屏」）；而进度安全
      已由进程级会话槽 SessionVault 承担，不再需要靠半透明让 MainActivity 保持 visible。
      因果全链见 AndroidManifest.xml 的 SettingsActivity 节点与 SettingsWindowAssemblyTest。
      今后若真要给别的 Activity 加半透明主题，另立条目写明自己的因果，别把设置页带回去。
    -->
</resources>
